              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QSpinBox" name="end_slice">
            <property name="sizePolicy">
             <sizepolicy hsizetype="Minimum" vsizetype="Fixed">
              <horstretch>1</horstretch>
              <verstretch>0</verstretch>
             </sizepolicy>
            </property>
            <property name="minimum">
             <number>1</number>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QHBoxLayout" name="right_sliders_layout">
        <property name="bottomMargin">
         <number>10</number>
        </property>
        <item>
         <widget class="QLabel" name="transparency_label">
          <property name="text">
           <string>Segmentation 
Transparency: </string>
          </property>
         </widget>
        </item>
        <item>
         <layout class="QVBoxLayout" name="transparency_sliders_layout">
          <property name="bottomMargin">
           <number>0</number>
          </property>
          <item>
           <widget class="QSlider" name="fat_slider">
            <property name="value">
             <number>50</number>
            </property>
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QSlider" name="water_slider">
            <property name="value">
             <number>50</number>
            </property>
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
           </widget>
          </item>
         </layout>
        </item>
       </layout>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QHBoxLayout" name="horizontalLayout">
      <item>
       <layout class="QVBoxLayout" name="left_buttons_layout">
        <item>
         <widget class="QPushButton" name="load_patients_button">
          <property name="text">
           <string>Load Patients...</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="swap_button">
          <property name="text">
           <string>Swap Datasets</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
      <item>
       <layout class="QVBoxLayout" name="right_buttons_layout">
        <item>
         <widget class="QPushButton" name="run_button">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="text">
           <string>Export Data &amp;&amp; Run Segmentation</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="save_button">
          <property name="enabled">
           <bool>false</bool>
          </property>
          <property name="text">
           <string>Save Segmentations</string>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect>
     <x>0</x>
     <y>0</y>
     <width>1012</width>
     <height>22</height>
    </rect>
   </property>
   <widget class="QMenu" name="menuView">
    <property name="title">
     <string>View</string>
    </property>
    <widget class="QMenu" name="menuColormap">
     <property name="title">
      <string>Colormap</string>
     </property>
     <addaction name="actionDefault"/>
     <addaction name="actionContrast"/>
     <addaction name="actionGrayscale"/>
     <addaction name="actionViridis"/>
     <addaction name="actionPaired"/>
     <addaction name="actionDark2"/>
    </widget>
    <addaction name="actionSwap"/>
    <addaction name="actionReset"/>
    <addaction name="menuColormap"/>
   </widget>
   <widget class="QMenu" name="menuFile">
    <property name="title">
     <string>File</string>
    </property>
    <addaction name="actionLoadPatients"/>
    <addaction name="actionLoadSeg"/>
    <addaction name="separator"/>
    <addaction name="actionSaveSeg"/>
    <addaction name="separator"/>
    <addaction name="actionExit"/>
   </widget>
   <widget class="QMenu" name="menuHelp">
    <property name="title">
     <string>Help</string>
    </property>
    <addaction name="actionDataset"/>
    <addaction name="actionAbout"/>
   </widget>
   <widget class="QMenu" name="menuRun">
    <property name="title">
     <string>Run</string>
    </property>
    <addaction name="actionDevice"/>
    <addaction name="actionSelectModel"/>
    <addaction name="separator"/>
    <addaction name="actionShowStatistics"/>
   </widget>
   <addaction name="menuFile"/>
   <addaction name="menuView"/>
   <addaction name="menuRun"/>
   <addaction name="menuHelp"/>
  </widget>
